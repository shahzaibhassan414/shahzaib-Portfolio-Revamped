# Contact form (POST /api/contact sends through Resend's HTTP API).
# Without RESEND_API_KEY and CONTACT_TO_EMAIL the form shows the fallback message with your email address.
RESEND_API_KEY=
CONTACT_TO_EMAIL=shahzaibhassan414@gmail.com
# Must be an address on a domain you've verified in Resend, for example hello@shahzaib-dev.site.
# If empty, Resend's test sender (onboarding@resend.dev) is used, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
